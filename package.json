{
  "name": "@danielsimonjr/repo-tools",
  "version": "2.5.0",
  "description": "One CLI for repository analysis: dependency graphs creation and query with per-export API facts, file chunking, and context compression. TypeScript on Bun, compiled to a single executable.",
  "type": "module",
  "license": "MIT",
  "author": "DANIEL SIMON JR",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielsimonjr/repo-tools.git"
  },
  "bin": {
    "repo-tools": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/*.wasm",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "test": "bun test",
    "hooks": "git config core.hooksPath .githooks",
    "privacy": "bun scripts/privacy-check.ts",
    "build": "bun scripts/build.ts",
    "compile": "bun scripts/build.ts --compile",
    "compare:docs": "bun scripts/docs-compare.ts",
    "smoke": "bun scripts/smoke.ts",
    "audit:ledger": "bun scripts/fix-ledger-audit.ts",
    "check:design": "bun scripts/design-refs.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tree-sitter-grammars/tree-sitter-kotlin": "1.1.0",
    "@types/bun": "1.4.2",
    "smol-toml": "1.9.0",
    "tree-sitter-c": "0.24.1",
    "tree-sitter-c-sharp": "0.23.5",
    "tree-sitter-cpp": "0.23.4",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-php": "0.24.2",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-ruby": "0.23.1",
    "tree-sitter-rust": "0.24.0",
    "tree-sitter-typescript": "0.23.2",
    "typescript": "7.0.2",
    "web-tree-sitter": "0.27.0"
  },
  "dependencies": {
    "js-yaml": "5.4.2"
  }
}
